# App
APP_NAME=Marcato
CLIENT_URL=http://localhost:3000
NODE_ENV=development
# Must match the api target in infra/prometheus/prometheus.yml (3000 stays for the client)
PORT=9001
SKIP_DB_CONNECT=false
RUN_SEED_ON_STARTUP=false

# MongoDB
MONGO_URI=mongodb://localhost:27017
MONGO_DB_NAME=saas_backend
MONGO_MAX_POOL_SIZE=100
MONGO_MIN_POOL_SIZE=10
MONGO_SERVER_SELECTION_TIMEOUT_MS=5000
MONGO_SOCKET_TIMEOUT_MS=45000
MONGO_CONNECT_TIMEOUT_MS=10000
MONGO_MAX_IDLE_TIME_MS=30000

# Auth
JWT_SECRET=changeme
JWT_EXPIRES_IN=900
REFRESH_TOKEN_TTL=604800
PASSWORD_RESET_TTL=1800

# Rate Limit
RATE_LIMIT_GLOBAL_TTL=60
RATE_LIMIT_GLOBAL_LIMIT=50
RATE_LIMIT_RESET_TTL=60
RATE_LIMIT_RESET_LIMIT=1

# Email
RESEND_API_KEY=
RESEND_FROM=onboarding@resend.dev
EMAIL_WELCOME_ENABLED=true

# Messaging
RABBITMQ_URL=amqp://guest:guest@localhost:5672
RABBITMQ_EXCHANGE=domain.events

# Metrics
METRICS_ENABLED=true
METRICS_ROUTE=/metrics

# Docs
DOCS_ENABLED=true
DOCS_VERSION=1.0

# Seed Admin
SUPER_ADMIN_EMAIL=admin@example.com
SUPER_ADMIN_NAME=Super Admin
SUPER_ADMIN_PASSWORD=admin123

# Google OAuth
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
GOOGLE_OAUTH_REDIRECT_URI=http://localhost:3000/auth/google/callback
GOOGLE_OAUTH_STATE_TTL=600

# CORS
CORS_ALLOWED_ORIGINS=["http://localhost:5173","https://localhost:5173", "http://localhost:3000","https://localhost:3000"]

# Geo Data Plane (PostgreSQL + PostGIS)
POSTGRES_DB=saas_geo
POSTGRES_USER=saas_geo
POSTGRES_PASSWORD=saas_geo
GEO_DB_URL=postgres://saas_geo:saas_geo@localhost:5432/saas_geo
GEO_DB_READ_URL=
GEO_DB_MAX_POOL_SIZE=10
GEO_DB_MIN_POOL_SIZE=1
GEO_DB_CONNECT_TIMEOUT_MS=10000
GEO_DB_STATEMENT_TIMEOUT_MS=30000
GEO_RAW_DIR=./data/geo
GEO_RAW_RETENTION_DAYS=30
GEO_INGEST_CONCURRENCY=1
GEO_JOB_STALE_MINUTES=30
GEO_JOB_POLL_SECONDS=15
GEO_JOB_RETENTION_DAYS=90
GEO_SCHEDULER_TICK_SECONDS=300
GEO_RUN_MIGRATIONS_ON_START=true
# Public share of the Receita Federal open CNPJ files (Nextcloud): the token is
# the share id, used as the WebDAV user. Rotation means a new share link.
RFB_CNPJ_SHARE_TOKEN=YggdBLfdninEJX9

# Workers
WORKER_METRICS_ENABLED=true
GEO_WORKER_METRICS_PORT=9464
EMAIL_WORKER_METRICS_PORT=9465

