{
  "uid": "all-in-one",
  "title": "All-in-One Observability",
  "timezone": "browser",
  "schemaVersion": 38,
  "version": 1,
  "refresh": "10s",
  "time": {
    "from": "now-6h",
    "to": "now"
  },
  "panels": [
    {
      "type": "stat",
      "title": "API Status",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [{ "expr": "up{job=\"api\"}", "refId": "A" }],
      "gridPos": { "h": 4, "w": 4, "x": 0, "y": 0 }
    },
    {
      "type": "stat",
      "title": "Requests / sec",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [{ "expr": "sum(rate(http_requests_total[5m]))", "refId": "A" }],
      "fieldConfig": { "defaults": { "unit": "ops", "decimals": 2 } },
      "gridPos": { "h": 4, "w": 4, "x": 4, "y": 0 }
    },
    {
      "type": "stat",
      "title": "5xx / sec",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [{ "expr": "sum(rate(http_requests_total{status=~\"5..\"}[5m]))", "refId": "A" }],
      "fieldConfig": { "defaults": { "unit": "ops", "decimals": 2 } },
      "gridPos": { "h": 4, "w": 4, "x": 8, "y": 0 }
    },
    {
      "type": "stat",
      "title": "p95 Latency (ms)",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [
        {
          "expr": "histogram_quantile(0.95, sum(rate(http_request_duration_seconds_bucket[5m])) by (le)) * 1000",
          "refId": "A"
        }
      ],
      "fieldConfig": { "defaults": { "unit": "ms", "decimals": 0 } },
      "gridPos": { "h": 4, "w": 4, "x": 12, "y": 0 }
    },
    {
      "type": "stat",
      "title": "Event Loop Delay (ms)",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [{ "expr": "nodejs_eventloop_lag_seconds * 1000", "refId": "A" }],
      "fieldConfig": { "defaults": { "unit": "ms", "decimals": 1 } },
      "gridPos": { "h": 4, "w": 4, "x": 16, "y": 0 }
    },
    {
      "type": "stat",
      "title": "Email Queue Backlog",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [
        {
          "expr": "sum(rabbitmq_queue_messages_ready{queue=~\"email\\\\..+\"}) + sum(rabbitmq_queue_messages_unacked{queue=~\"email\\\\..+\"})",
          "refId": "A"
        }
      ],
      "fieldConfig": { "defaults": { "unit": "short", "decimals": 0 } },
      "gridPos": { "h": 4, "w": 4, "x": 20, "y": 0 }
    },
    {
      "type": "timeseries",
      "title": "HTTP Requests by Status",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [
        {
          "expr": "sum(rate(http_requests_total[5m])) by (status)",
          "legendFormat": "{{status}}",
          "refId": "A"
        }
      ],
      "fieldConfig": { "defaults": { "unit": "ops" } },
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 4 }
    },
    {
      "type": "timeseries",
      "title": "HTTP Latency p50/p95/p99 (ms)",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [
        {
          "expr": "histogram_quantile(0.5, sum(rate(http_request_duration_seconds_bucket[5m])) by (le)) * 1000",
          "legendFormat": "p50",
          "refId": "A"
        },
        {
          "expr": "histogram_quantile(0.95, sum(rate(http_request_duration_seconds_bucket[5m])) by (le)) * 1000",
          "legendFormat": "p95",
          "refId": "B"
        },
        {
          "expr": "histogram_quantile(0.99, sum(rate(http_request_duration_seconds_bucket[5m])) by (le)) * 1000",
          "legendFormat": "p99",
          "refId": "C"
        }
      ],
      "fieldConfig": { "defaults": { "unit": "ms" } },
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 4 }
    },
    {
      "type": "gauge",
      "title": "CPU Usage (%)",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [
        {
          "expr": "(rate(process_cpu_user_seconds_total[5m]) + rate(process_cpu_system_seconds_total[5m])) * 100",
          "refId": "A"
        }
      ],
      "fieldConfig": { "defaults": { "unit": "percent", "min": 0, "max": 100, "decimals": 1 } },
      "gridPos": { "h": 6, "w": 6, "x": 0, "y": 12 }
    },
    {
      "type": "timeseries",
      "title": "Process Memory (MB)",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [{ "expr": "process_resident_memory_bytes", "legendFormat": "rss", "refId": "A" }],
      "fieldConfig": { "defaults": { "unit": "bytes", "decimals": 0 } },
      "gridPos": { "h": 6, "w": 9, "x": 6, "y": 12 }
    },
    {
      "type": "gauge",
      "title": "Heap Usage (%)",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [
        {
          "expr": "(nodejs_heap_size_used_bytes / nodejs_heap_size_total_bytes) * 100",
          "refId": "A"
        }
      ],
      "fieldConfig": { "defaults": { "unit": "percent", "min": 0, "max": 100, "decimals": 1 } },
      "gridPos": { "h": 6, "w": 9, "x": 15, "y": 12 }
    },
    {
      "type": "timeseries",
      "title": "Event Loop Delay (ms)",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [
        { "expr": "nodejs_eventloop_lag_seconds * 1000", "legendFormat": "lag", "refId": "A" }
      ],
      "fieldConfig": { "defaults": { "unit": "ms" } },
      "gridPos": { "h": 6, "w": 12, "x": 0, "y": 18 }
    },
    {
      "type": "timeseries",
      "title": "GC p95 (ms)",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [
        {
          "expr": "histogram_quantile(0.95, sum(rate(nodejs_gc_duration_seconds_bucket[5m])) by (le)) * 1000",
          "legendFormat": "p95",
          "refId": "A"
        }
      ],
      "fieldConfig": { "defaults": { "unit": "ms" } },
      "gridPos": { "h": 6, "w": 12, "x": 12, "y": 18 }
    },
    {
      "type": "bargauge",
      "title": "Email Queue Messages",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [
        {
          "expr": "sum(rabbitmq_queue_messages{queue=~\"email\\\\..+\"}) by (queue)",
          "legendFormat": "{{queue}}",
          "refId": "A"
        }
      ],
      "fieldConfig": { "defaults": { "unit": "short", "decimals": 0 } },
      "gridPos": { "h": 7, "w": 12, "x": 0, "y": 24 }
    },
    {
      "type": "bargauge",
      "title": "Email Queue Consumers",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [
        {
          "expr": "sum(rabbitmq_queue_consumers{queue=~\"email\\\\..+\"}) by (queue)",
          "legendFormat": "{{queue}}",
          "refId": "A"
        }
      ],
      "fieldConfig": { "defaults": { "unit": "short", "decimals": 0 } },
      "gridPos": { "h": 7, "w": 12, "x": 12, "y": 24 }
    },
    {
      "type": "piechart",
      "title": "HTTP Status Share",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [
        {
          "expr": "sum(rate(http_requests_total[5m])) by (status)",
          "legendFormat": "{{status}}",
          "refId": "A"
        }
      ],
      "gridPos": { "h": 8, "w": 8, "x": 0, "y": 31 }
    },
    {
      "type": "timeseries",
      "title": "Queue Throughput (messages/sec)",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [
        {
          "expr": "sum(rate(rabbitmq_channel_messages_published_total[5m]))",
          "legendFormat": "published",
          "refId": "A"
        },
        {
          "expr": "sum(rate(rabbitmq_channel_messages_acked_total[5m]))",
          "legendFormat": "acked",
          "refId": "B"
        }
      ],
      "fieldConfig": { "defaults": { "unit": "ops" } },
      "gridPos": { "h": 8, "w": 16, "x": 8, "y": 31 }
    }
  ]
}
